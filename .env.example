# EXPIREDNOT Email & AI Configuration
# Copy this file to .env to enable real physical email dispatch and Google Gemini Multimodal AI

# Option 1: Gmail SMTP (Recommended for personal Gmail accounts)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER="your_email@gmail.com"
GMAIL_APP_PASSWORD="your_16_character_app_password"

# Option 2: Resend API (Free transactional email service)
# Get a free key at: https://resend.com
# RESEND_API_KEY="re_123456789"

# Option 3: Standard Custom SMTP (SendGrid, Postmark, AWS SES, Brevo)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your_email@gmail.com"
# SMTP_PASS="your_password"

# Optional: Google Gemini Multimodal AI Key for invoice scanning
# GEMINI_API_KEY="AIzaSy..."
