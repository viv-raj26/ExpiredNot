# EXPIREDNOT Configuration
# Copy this file to .env to configure your local credentials

# ==============================================================================
# 1. Google OAuth 2.0 Client ID (Web Application)
# ==============================================================================
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth Client ID (Web application)
# Authorized JavaScript origins: http://localhost:3000
# Authorized redirect URIs: http://localhost:3000
GOOGLE_CLIENT_ID=""

# ==============================================================================
# 2. Email Delivery Configuration for Real Email OTPs
# ==============================================================================
# Option A: Gmail SMTP (Personal Gmail Account)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Option B: Resend API (Free transactional email service at https://resend.com)
# RESEND_API_KEY=""

# Option C: Standard Custom SMTP (SendGrid, Brevo, AWS SES, Postmark)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""

# ==============================================================================
# 3. Google Gemini Multimodal AI Key for Smart Bill Capture
# ==============================================================================
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
